# Database (SQLite - just a local file, no server needed)
DATABASE_URL="file:./dev.db"

# JWT secrets - change these to random long strings in production
JWT_SECRET="replace_this_with_a_long_random_string"
JWT_REMEMBER_ME_EXPIRY="30d"
JWT_DEFAULT_EXPIRY="1d"

# Server
PORT=5000
CLIENT_URL="http://localhost:3000"

# Google OAuth (get these from https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="https://ai-grader-backend-02cv.onrender.com/api/auth/google/callback"

# Microsoft OAuth (get these from https://portal.azure.com -> App registrations)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_CALLBACK_URL="https://ai-grader-backend-02cv.onrender.com/api/auth/microsoft/callback"
